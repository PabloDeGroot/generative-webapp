# Non-secret function configuration. Committed on purpose: Firebase loads this file
# at deploy time. Never put API keys here — they live in Google Secret Manager
# (see functions/src/secrets.ts) and locally in functions/.secret.local.

PUBLIC_FIREBASE_STORAGE_BUCKET=generativewebpage.firebasestorage.app

# Toolkit used when a request names none. Keep in sync with TOOLKIT_ID in the root .env.
TOOLKIT_ID=dictionary

# Auth gate: when true, callable functions only accept Google sign-ins.
# Keep in sync with AUTH_GATE in the root .env.
AUTH_GATE=true

# Per-prompt model selection
COMPONENT_DESIGNER_MODEL=gpt-oss-120b
COMPONENT_CODEGEN_MODEL=gpt-oss-120b
COMPONENT_EVALUATOR_MODEL=gpt-oss-120b
FEEDBACK_EVALUATOR_MODEL=gpt-oss-120b
COMPONENT_INITIALIZER_MODEL=gpt-oss-120b
COMPONENT_CURATOR_MODEL=gpt-oss-120b

# The only identity allowed to call the mcp function: the service account the deployed
# SvelteKit server (ssr function) runs as. Leave empty to make mcp fully private.
MCP_INVOKER_SERVICE_ACCOUNT=39079507166-compute@developer.gserviceaccount.com
