# AI provider keys
CEREBRAS_API_KEY=your-cerebras-key
GEMINI_API_KEY=your-gemini-key
OPENAI_API_KEY=your-openai-key

# Asset sourcing
POLY_PIZZA_API_KEY=your-poly-pizza-key

# Firebase
PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
# Path to your service-account JSON, used only by load-models-local.js
GOOGLE_APPLICATION_CREDENTIALS=./credential.json

# Per-prompt model selection (Firebase functions side)
COMPONENT_DESIGNER_MODEL=gpt-oss-120b
COMPONENT_CODEGEN_MODEL=gpt-oss-120b
COMPONENT_EVALUATOR_MODEL=gpt-oss-120b
FEEDBACK_EVALUATOR_MODEL=gpt-oss-120b
COMPONENT_INITIALIZER_MODEL=gpt-oss-120b
COMPONENT_CURATOR_MODEL=gpt-oss-120b
