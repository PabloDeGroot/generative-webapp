# Non-secret app configuration. Committed on purpose: it is baked into the build
# (and the PUBLIC_* values are shipped to every browser anyway). Never put API keys
# here — they live in Google Secret Manager and locally in .secret.local.

# Firebase web app config
PUBLIC_FIREBASE_API_KEY=AIzaSyAcl1hO6oTnE1LK8swTp8QKpwn_cpria1s
PUBLIC_FIREBASE_AUTH_DOMAIN=generativewebpage.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=generativewebpage
PUBLIC_FIREBASE_STORAGE_BUCKET=generativewebpage.firebasestorage.app
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=39079507166
PUBLIC_FIREBASE_APP_ID=1:39079507166:web:bbd4bae08e1bd207ccfe4f
PUBLIC_FIREBASE_MEASUREMENT_ID=G-J50ZWYM5KK

# Google Analytics 4 Measurement Protocol (the API secret lives in Secret Manager)
GA_MEASUREMENT_ID=G-J50ZWYM5KK

# Cloudflare Turnstile (the site key is public)
PUBLIC_TURNSTILE_SITE_KEY=

# Optional: override the MCP endpoint (defaults to the local emulator in dev and the
# deployed Firebase Function otherwise)
#MCP_ENDPOINT=

# Per-prompt model selection
PAGE_DESIGNER_MODEL=gpt-oss-120b
HTML_GENERATOR_MODEL=gpt-oss-120b
ACTION_RUNNER_MODEL=gpt-oss-120b
IMAGE_DESCRIPTION_MODEL=llama3.1-8b
IMAGE_GENERATION_MODEL=runware:100@1
